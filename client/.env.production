# Production build values (safe to commit). Local overrides belong in
# .env.production.local, which is gitignored.

# Left empty on purpose. VUEDA derives the API origin from the page's own hostname and
# protocol, and only overrides the port when this is set. In production nginx serves the
# client and proxies the API on the same origin, so any port here would send requests
# somewhere else.
VITE_DJANGO_CONNECTION_PORT=

VITE_CSRF_COOKIE_NAME=widget-warehouse-csrf-token
