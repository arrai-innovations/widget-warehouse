# The end-to-end test client (`vite --mode e2e`, started by playwright.config.js). A
# separate mode rather than development, so .env.development.local (a developer's HTTPS
# and HMR settings) does not apply to it. The port must match the test server's,
# E2E_SERVER_PORT in playwright.config.js.
VITE_DJANGO_CONNECTION_PORT=8100

VITE_CSRF_COOKIE_NAME=widget-warehouse-csrf-token
